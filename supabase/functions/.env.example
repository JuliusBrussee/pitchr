# Supabase Edge Functions environment example
# Set these as Supabase project secrets for deployed edge functions.
# For local edge development, you can copy this to supabase/functions/.env.

# Analysis providers
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Live QA gate + ElevenLabs ConvAI
NEXT_PUBLIC_ENABLE_LIVE_QA=false
ELEVENLABS_API_KEY_CONVAI=
ELEVENLABS_CONVAI_AGENT_ID=

# Optional fallback key name accepted by shared ConvAI helper
ELEVENLABS_API_KEY_STT=
ELEVENLABS_API_KEY=

# Local diagnostics (never enable in production)
NODE_ENV=development
PITCHR_DIAGNOSTIC_LOGS=false
