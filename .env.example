# Server-side: ElevenLabs API key (required for STT)
ELEVENLABS_API_KEY=your_key_here

# LLM routing (OpenRouter default for this phase)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Future provider switch target
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# When running "npm run dev" (Next on :3000, Express on :3001), set this so the app connects to the STT backend:
NEXT_PUBLIC_WS_URL=http://localhost:3001
