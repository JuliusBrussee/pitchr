# Copy to .env or .env.local and fill in values.

# LLM routing policy
LLM_ROUTING_MODE=openrouter_then_anthropic
LLM_PROVIDER_PRIMARY=openrouter
LLM_PROVIDER_FALLBACK=anthropic
# Backward compatible legacy selector:
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Future provider switch target
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Realtime STT (required for recording)
ELEVENLABS_API_KEY_STT=

# Coach question + feedback (LLM)
PLACE_HOLDER_PITCH=

# Coach voice feedback (TTS) – required for "Play coach feedback"
ELEVENLABS_API_KEY_TTS=
ELEVENLABS_VOICE_ID=

# Optional
PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
