# Server-side: ElevenLabs API key (required for STT)
ELEVENLABS_API_KEY=your_key_here

# LLM routing (Anthropic default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional rollback provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# When running "yarn dev" (Next on :3000, Express on :3001), set this so the app connects to the STT backend:
NEXT_PUBLIC_WS_URL=http://localhost:3001
