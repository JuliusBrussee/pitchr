# Copy to .env.local (local web + sidecar runtime).
# Edge-function secrets belong in Supabase project secrets (see supabase/functions/.env.example).

# -----------------------------------------------------------------------------
# Runtime: Next.js web app (browser + app host)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
NEXT_PUBLIC_WS_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Runtime: Express sidecar (server.ts) for realtime STT/TTS
# -----------------------------------------------------------------------------
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# STT key (primary + accepted aliases)
ELEVENLABS_API_KEY_STT=
ELEVENLABS_API_KEY=

# TTS key/voice for coach playback
ELEVENLABS_API_KEY_TTS=
ELEVENLABS_VOICE_ID=

# Optional live QA-related keys used by sidecar tooling
ELEVENLABS_API_KEY_CONVAI=
ELEVENLABS_CONVAI_AGENT_ID=
NEXT_PUBLIC_ENABLE_LIVE_QA=false

# LLM routing for sidecar checklist/coach helper behavior
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
CHECKLIST_LLM_PROVIDER=
PLACE_HOLDER_PITCH=

# -----------------------------------------------------------------------------
# Runtime: Shared feature flags / product behavior
# -----------------------------------------------------------------------------
ENABLE_SECTION_FEEDBACK=true
ENABLE_REWRITE_DIFF=true
ENABLE_KNOWLEDGE_CALIBRATED_JUDGE=true
EXPOSE_JUDGE_CITATIONS=false

# -----------------------------------------------------------------------------
# Optional: Paid.ai value-proof sync
# -----------------------------------------------------------------------------
PAID_ENABLED=false
PAID_API_KEY=
PAID_API_BASE_URL=https://api.paid.ai
PAID_PRODUCT_ID=
PAID_EXTERNAL_PRODUCT_ID=product_456
PAID_CUSTOMER_ID=
PAID_EXTERNAL_CUSTOMER_ID=customer_123
PAID_ORDER_ID=
PAID_SIGNAL_EVENT_COMPLETED=pitch_analysis_completed
PAID_SIGNAL_EVENT_INVESTOR_READY=investor_ready_achieved

# Optional: Miro integration
MIRO_ENABLED=false
MIRO_PROVIDER=miro_rest
MIRO_ACCESS_TOKEN=
MIRO_TEAM_ID=
NEXT_PUBLIC_MIRO_POLL_INTERVAL_MS=8000

# Optional: billing/test helpers
BILLING_DEV_USER_IDS=

# -----------------------------------------------------------------------------
# Optional: Economics model defaults
# -----------------------------------------------------------------------------
COACH_HOURLY_RATE_USD=200
VALUE_PER_SCORE_POINT_USD=2
ANTHROPIC_INPUT_PER_1M_USD=3
ANTHROPIC_OUTPUT_PER_1M_USD=15
OPENROUTER_INPUT_PER_1M_USD=3
OPENROUTER_OUTPUT_PER_1M_USD=15
MANUAL_BASELINE_ELEVATOR_MIN=8
MANUAL_BASELINE_VC_MIN=16
ECON_PLATFORM_OVERHEAD_USD=1.5
ECON_MIN_RUN_COST_USD=2.5
ECON_OPERATIONS_BUFFER_MIN=2
ECON_QUALITY_BONUS_MAX_POINTS=6
ECON_SAVINGS_REALIZATION_RATE=0.35
ECON_MAX_SAVED_MINUTES=6
