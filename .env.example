# Copy to .env or .env.local and fill in values.

# LLM routing (Anthropic default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional rollback provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# STT (required for recording, upload transcription, and live WPM/fillers)
# Get key: https://www.assemblyai.com/app/account
# Without this: batch transcript on stop works if you use another path; live streaming and WPM do not.
ASSEMBLYAI_API_KEY=
# Optional: EU data residency (default https://api.assemblyai.com)
# ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# Live Conversational AI (required for native VC Q&A)
ELEVENLABS_API_KEY_CONVAI=
ELEVENLABS_CONVAI_AGENT_ID=

# Coach question + feedback (LLM)
PLACE_HOLDER_PITCH=

# Coach voice feedback (TTS) - required for "Play coach feedback"
ELEVENLABS_API_KEY_TTS=
ELEVENLABS_VOICE_ID=

# Feature flags
ENABLE_SECTION_FEEDBACK=true
ENABLE_REWRITE_DIFF=true
ENABLE_KNOWLEDGE_CALIBRATED_JUDGE=true
EXPOSE_JUDGE_CITATIONS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Batch runner auth (one option required)
PITCHR_BATCH_JWT=
PITCHR_BATCH_EMAIL=
PITCHR_BATCH_PASSWORD=

# Optional
PORT=3001

# When running "yarn dev" (Next on :3000, Express on :3001), set this so the app connects to the STT backend:
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Dev accounts — comma-separated Supabase user IDs that bypass all billing limits
BILLING_DEV_USER_IDS=

# Supabase admin (required for billing API routes)
SUPABASE_SERVICE_ROLE_KEY=

# App base URL used in email links (unsubscribe, etc.)
APP_BASE_URL=http://localhost:3000

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional reply-to mailbox
RESEND_REPLY_TO=

# Stripe billing (required for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_DAY_PASS_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Economics model defaults
# User-savings model inputs
COACH_HOURLY_RATE_USD=200
VALUE_PER_SCORE_POINT_USD=2
ANTHROPIC_INPUT_PER_1M_USD=3
ANTHROPIC_OUTPUT_PER_1M_USD=15
OPENROUTER_INPUT_PER_1M_USD=3
OPENROUTER_OUTPUT_PER_1M_USD=15
MANUAL_BASELINE_ELEVATOR_MIN=8
MANUAL_BASELINE_VC_MIN=16
ECON_PLATFORM_OVERHEAD_USD=1.5
ECON_MIN_RUN_COST_USD=2.5
ECON_OPERATIONS_BUFFER_MIN=2
ECON_QUALITY_BONUS_MAX_POINTS=6
ECON_SAVINGS_REALIZATION_RATE=0.35
ECON_MAX_SAVED_MINUTES=6

# Error monitoring (Sentry — optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
